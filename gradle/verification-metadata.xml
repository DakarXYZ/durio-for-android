<?xml version="1.0" encoding="UTF-8"?>
<!--
  durio: dependency verification only for the E2EE core AAR (plan AN-20, Q36). It comes from
  GitHub Releases of DakarXYZ/durio-crypt (or a local build, scripts/durio-crypto-local.sh) and
  is pinned by SHA-256; every other artifact is trusted as before (Maven Central, Google).
  A new core version: take the value from stoat-crypto-<v>.aar.sha256 of its release.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!io[.]github[.]dakarxyz[.]durio$).*$" regex="true" reason="only the E2EE core is pinned"/>
         <trust group="io.github.dakarxyz.durio" name="stoat-crypto" file=".*[.](pom|module)$" regex="true" reason="metadata of the local maven build only; the AAR is used without it (@aar)"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="io.github.dakarxyz.durio" name="stoat-crypto" version="0.2.1">
         <artifact name="stoat-crypto-0.2.1.aar">
            <sha256 value="e56f65447a231c97c32e21f0c7a065659ad49558d87516bb6399775d8e541c2f" origin="durio-crypt 2f0a8f4, build of v0.2.1 (build/dist/stoat-crypto-0.2.1.aar.sha256)"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
