<?xml version="1.0" encoding="UTF-8"?>
<!--
  durio: dependency verification only for the E2EE core AAR (plan AN-20, Q36). It comes from
  GitHub Releases of DakarXYZ/durio-crypt (or a local build, scripts/durio-crypto-local.sh) and
  is pinned by SHA-256; every other artifact is trusted as before (Maven Central, Google).
  A new core version: take the value from durio-crypt-<v>.aar.sha256 of its release.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!io[.]github[.]dakarxyz[.]durio$).*$" regex="true" reason="only the E2EE core is pinned"/>
         <trust group="io.github.dakarxyz.durio" name="durio-crypt" file=".*[.](pom|module)$" regex="true" reason="metadata of the local maven build only; the AAR is used without it (@aar)"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="io.github.dakarxyz.durio" name="durio-crypt" version="0.2.4">
         <artifact name="durio-crypt-0.2.4.aar">
            <sha256 value="ecac681d2a48d6317eed3d906c72ec3e4795d83fa2bbb832d775cbf4b2c6d868" origin="GitHub Release v0.2.4 of durio-crypt (5046b32), durio-crypt-0.2.4.aar.sha256"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
