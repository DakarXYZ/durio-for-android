# Allowed hits of scripts/check-upstream-hosts.sh (plan AN-07): extended regexes matched
# against grep output "path:line:text". Everything else is a hard-coded upstream host.

# The one config spot: upstream addresses, used only for accounts on the upstream server
^core/model/src/commonMain/kotlin/chat/stoat/core/model/fork/UpstreamStoat\.kt:

# Tests: canonicalApiUrl vectors shared with pushd, recognition of the upstream server
^core/(api|model)/src/(commonTest|androidHostTest)/
^app/src/test/java/chat/stoat/fork/upstream/

# Upstream's spec link in a comment
^app/src/main/java/chat/stoat/screens/chat/views/channel/ChannelScreenViewModel\.kt:[0-9]+: *// Spec https://wiki\.rvlt\.gg/
