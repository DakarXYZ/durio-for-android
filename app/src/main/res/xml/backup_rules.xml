<?xml version="1.0" encoding="utf-8"?>
<!-- durio: nothing is backed up (Android < 12). Tokens and keys are wrapped with Android Keystore keys
     that never leave the device, so a restored copy would be unusable anyway. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
